<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <RunicAssetsDist>$(MSBuildProjectDirectory)/vite-dist</RunicAssetsDist>
    <RunicAssetsEntryPoint>app.html</RunicAssetsEntryPoint>
    <RunicAssetsDistExclude>runic-assets.zip;excluded.txt</RunicAssetsDistExclude>
    <RunicAssetsEmbeddedResourceName>RunicAssets.CsWebUiAotSmoke.Assets</RunicAssetsEmbeddedResourceName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RunicAssets/RunicAssets.csproj" />
    <ProjectReference Include="../../src/RunicAssets.CsWebUi/RunicAssets.CsWebUi.csproj" />
  </ItemGroup>

  <!-- NuGet consumers receive this import automatically from buildTransitive. -->
  <Import Project="../../src/RunicAssets/buildTransitive/RunicAssets.targets" />
</Project>

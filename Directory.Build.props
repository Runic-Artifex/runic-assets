<Project>
  <PropertyGroup>
    <!--
      Development is the approachable inner loop. Verification is selected by CI
      and eng/verify.ps1 for release-grade analysis.
    -->
    <RunicAssetsBuildMode Condition="'$(RunicAssetsBuildMode)' == '' and '$(CI)' == 'true'">Verification</RunicAssetsBuildMode>
    <RunicAssetsBuildMode Condition="'$(RunicAssetsBuildMode)' == ''">Development</RunicAssetsBuildMode>
    <RunicAssetsVerificationBuild Condition="'$(RunicAssetsBuildMode)' == 'Verification'">true</RunicAssetsVerificationBuild>
    <RunicAssetsVerificationBuild Condition="'$(RunicAssetsVerificationBuild)' == ''">false</RunicAssetsVerificationBuild>

    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(RunicAssetsVerificationBuild)' == 'true'">true</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryType>git</RepositoryType>
    <Authors>RunicArtifex</Authors>
    <Company>RunicArtifex</Company>
    <Copyright>Copyright (c) 2026 Viktor Jannicke</Copyright>
    <RepositoryUrl>https://github.com/Runic-Artifex/runic-assets</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageProjectUrl>https://github.com/Runic-Artifex/runic-assets</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags Condition="'$(PackageTags)' == ''">runic-artifex;assets;dotnet;nativeaot</PackageTags>
    <!-- Libraries leave dependency resolution to their consuming applications. -->
    <NuGetAudit Condition="'$(RunicAssetsVerificationBuild)' == 'true'">true</NuGetAudit>
    <NuGetAudit Condition="'$(NuGetAudit)' == ''">false</NuGetAudit>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    <RunicAssetsDefaultTargetFramework>net10.0</RunicAssetsDefaultTargetFramework>
  </PropertyGroup>
</Project>

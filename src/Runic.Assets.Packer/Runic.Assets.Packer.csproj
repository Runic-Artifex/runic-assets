<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RunicAssetsShippingProject>true</RunicAssetsShippingProject>
    <AssemblyName>Runic.Assets.Packer</AssemblyName>
    <RootNamespace>Runic.Assets.Packer</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Runic.Assets/Runic.Assets.csproj" />
    <ProjectReference Include="$(RunicAssetsDependencyRoot)/runic-command-line/src/Runic.CommandLine/Runic.CommandLine.csproj"
                      Condition="Exists('$(RunicAssetsDependencyRoot)/runic-command-line/src/Runic.CommandLine/Runic.CommandLine.csproj')" />
    <ProjectReference Include="$(RunicAssetsDependencyRoot)/runic-command-line/src/Runic.CommandLine.Generators/Runic.CommandLine.Generators.csproj"
                      Condition="Exists('$(RunicAssetsDependencyRoot)/runic-command-line/src/Runic.CommandLine.Generators/Runic.CommandLine.Generators.csproj')"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
    <PackageReference Include="Runic.CommandLine"
                      Condition="!Exists('$(RunicAssetsDependencyRoot)/runic-command-line/src/Runic.CommandLine/Runic.CommandLine.csproj')" />
  </ItemGroup>
</Project>

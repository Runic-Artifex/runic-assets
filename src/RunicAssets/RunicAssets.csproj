<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicAssetsDefaultTargetFramework)</TargetFramework>
    <RunicAssetsShippingProject>true</RunicAssetsShippingProject>
    <AssemblyName>RunicAssets</AssemblyName>
    <RootNamespace>RunicAssets</RootNamespace>
    <PackageId>RunicAssets</PackageId>
    <Description>Framework-neutral deterministic asset manifests, sources, and archives.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RunicAssets.Packer/RunicAssets.Packer.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive/RunicAssets.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../RunicAssets.Packer/bin/$(Configuration)/net10.0/RunicAssets.Packer.dll"
          Pack="true"
          PackagePath="tools/net10.0/" />
    <None Include="../RunicAssets.Packer/bin/$(Configuration)/net10.0/RunicAssets.Packer.deps.json"
          Pack="true"
          PackagePath="tools/net10.0/" />
    <None Include="../RunicAssets.Packer/bin/$(Configuration)/net10.0/RunicAssets.Packer.runtimeconfig.json"
          Pack="true"
          PackagePath="tools/net10.0/" />
  </ItemGroup>
</Project>

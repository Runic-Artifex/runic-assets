<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicAssetsDefaultTargetFramework)</TargetFramework>
    <RunicAssetsShippingProject>true</RunicAssetsShippingProject>
    <AssemblyName>RunicAssets.AspNetCore</AssemblyName>
    <RootNamespace>RunicAssets.AspNetCore</RootNamespace>
    <PackageId>RunicAssets.AspNetCore</PackageId>
    <Description>ASP.NET Core endpoint integration for Runic Assets.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RunicAssets/RunicAssets.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>

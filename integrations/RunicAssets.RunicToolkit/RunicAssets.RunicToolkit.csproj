<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicAssetsDefaultTargetFramework)</TargetFramework>
    <AssemblyName>RunicAssets.RunicToolkit</AssemblyName>
    <RootNamespace>RunicAssets.RunicToolkit</RootNamespace>
    <PackageId>RunicAssets.RunicToolkit</PackageId>
    <Title>Runic Assets integration for Runic Toolkit</Title>
    <Description>Runic Toolkit frontend asset provider integration owned and released by Runic Assets.</Description>
    <PackageTags>runic;assets;toolkit;hosting;frontend</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <RunicAssetsShippingProject>true</RunicAssetsShippingProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RunicAssets/RunicAssets.csproj" />
    <PackageReference Include="RunicToolkit.Hosting.Abstractions" Version="[0.1.0-preview.21.1]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
